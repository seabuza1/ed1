# Copie para .env (que fica fora do git) e preencha com os dados do projeto no Supabase
# (Project Settings → API). Na Vercel, as mesmas variáveis em Settings → Environment Variables.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Só para npm run comparar (scripts/comparar-modelos.ts). O app só leva as variáveis VITE_.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# DASHSCOPE_API_KEY=
# Servidor no formato do OpenAI (modelos como compativel:<modelo>):
# COMPATIVEL_URL=https://.../v1
# COMPATIVEL_API_KEY=
